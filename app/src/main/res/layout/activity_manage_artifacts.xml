<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment"
    tools:context=".ManageArtifactsActivity">

    <ImageButton
        android:id="@+id/buttonBackManage"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:tint="@color/ink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textPageTitle"
        style="@style/TextAppearance.TAAM.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:text="@string/manage_artifacts_title"
        app:layout_constraintBottom_toBottomOf="@id/buttonBackManage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/buttonBackManage"
        app:layout_constraintTop_toTopOf="@id/buttonBackManage" />

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchManage"
        android:theme="@style/ThemeOverlay.TAAM.SearchView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:iconifiedByDefault="false"
        app:queryHint="@string/search_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textPageTitle" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/manageScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchManage">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.TAAM.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:text="@string/section_edit_delete" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/textNoMatches"
                    style="@style/TextAppearance.TAAM.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:paddingHorizontal="32dp"
                    android:text="@string/empty_no_artifacts"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerManage"
                    android:layout_width="match_parent"
                    android:layout_height="420dp"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="true"
                    tools:listitem="@layout/row_manage_artifact" />

            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddForm"
                style="@style/Widget.TAAM.Card.Artifact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textFormTitle"
                        style="@style/TextAppearance.TAAM.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_add_artifact" />

                    <TextView
                        android:id="@+id/textEditingBanner"
                        style="@style/TextAppearance.TAAM.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/editing_banner"
                        android:textColor="@color/cinnabar"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <EditText
                        android:id="@+id/editLot"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_lot_number"
                        android:inputType="text"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/editName"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_artifact_name"
                        android:inputType="text"
                        android:maxLines="1" />

                    <Spinner
                        android:id="@+id/spinnerCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/muted_taupe"
                        android:spinnerMode="dropdown" />

                    <Spinner
                        android:id="@+id/spinnerDynasty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/muted_taupe"
                        android:spinnerMode="dropdown" />

                    <Spinner
                        android:id="@+id/spinnerMaterial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/muted_taupe"
                        android:spinnerMode="dropdown" />

                    <EditText
                        android:id="@+id/editDimensions"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_dimensions"
                        android:inputType="text"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/editCulturalOrigin"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_cultural_origin"
                        android:inputType="text"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/editCurrentLocation"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_current_location"
                        android:inputType="text"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/editAccessionNumber"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_accession_number"
                        android:inputType="text"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/editAcquisitionMethod"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_acquisition_method"
                        android:inputType="text"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/editProvenance"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="top"
                        android:hint="@string/hint_provenance"
                        android:inputType="textMultiLine"
                        android:minLines="2" />

                    <EditText
                        android:id="@+id/editConditionReport"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="top"
                        android:hint="@string/hint_condition_report"
                        android:inputType="textMultiLine"
                        android:minLines="2" />

                    <EditText
                        android:id="@+id/editDescription"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="top"
                        android:hint="@string/hint_description"
                        android:inputType="textMultiLine"
                        android:minLines="3" />

                    <EditText
                        android:id="@+id/editNotes"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="top"
                        android:hint="@string/hint_notes"
                        android:inputType="textMultiLine"
                        android:minLines="2" />

                    <EditText
                        android:id="@+id/editImageUrl"
                        style="@style/Widget.TAAM.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_image_url"
                        android:inputType="textUri"
                        android:maxLines="1" />

                    <Button
                        android:id="@+id/buttonUploadImage"
                        style="@style/Widget.TAAM.Button.Admin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/action_upload_image" />

                    <Button
                        android:id="@+id/buttonSubmitArtifact"
                        style="@style/Widget.TAAM.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/action_add_artifact" />

                    <Button
                        android:id="@+id/buttonCancelEdit"
                        style="@style/Widget.TAAM.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_cancel_edit"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
