<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TAAM.Card.Artifact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageArtifact"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:background="@color/border_tan"
            android:contentDescription="@string/artifact_image_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/textArtifactName"
            style="@style/TextAppearance.TAAM.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artifact Name" />

        <TextView
            android:id="@+id/textLotNumber"
            style="@style/TextAppearance.TAAM.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lot Number: Unique ID" />

        <TextView
            android:id="@+id/textCategory"
            style="@style/TextAppearance.TAAM.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: " />

        <TextView
            android:id="@+id/textMaterial"
            style="@style/TextAppearance.TAAM.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Material: " />

        <TextView
            android:id="@+id/textDynastyPeriod"
            style="@style/TextAppearance.TAAM.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dynasty Period: " />

        <TextView
            android:id="@+id/textDescription"
            style="@style/TextAppearance.TAAM.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonReadMore"
                style="@style/Widget.TAAM.Button.Admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read more" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/buttonLike"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Like artifact"
                android:padding="8dp"
                android:src="@drawable/ic_heart_outline" />

            <TextView
                android:id="@+id/textLikeCount"
                style="@style/TextAppearance.TAAM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:minWidth="20dp"
                android:text="0" />

            <ImageButton
                android:id="@+id/buttonSave"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save artifact"
                android:padding="8dp"
                android:src="@drawable/ic_bookmark_outline" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>