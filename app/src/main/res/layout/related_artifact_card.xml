<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TAAM.Card.Artifact"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageRelatedArtifact"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:adjustViewBounds="true"
            android:background="@color/border_tan"
            android:contentDescription="@string/artifact_image_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/textRelatedName"
            style="@style/TextAppearance.TAAM.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artifact Name" />

        <TextView
            android:id="@+id/textRelatedLotNumber"
            style="@style/TextAppearance.TAAM.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Lot Number: Unique ID" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
